mdp

formula success = x=4 & y=4;
formula unsafe = y=2 & (x=1 | x=2 | x=3);

label "success" = success;
label "unsafe" = unsafe;

formula done = success | unsafe;

module grid
    x: [0..4] init 0;
    y: [0..4] init 0;

    [UP] !done -> 0.9: (y'=max(0, y-1)) + 0.1: (y'=y);
    [DOWN] !done -> 0.9: (y'=min(y+1, 4)) + 0.1: (y'=y);
    [LEFT] !done -> 0.9: (x'=max(0, x-1)) + 0.1: (x'=x);
    [RIGHT] !done -> 0.9: (x'=min(x+1, 4)) + 0.1: (x'=x);
endmodule

rewards "reward"
    [RIGHT] !done & x=3 & y=4: 10;
    [DOWN] !done & x=4 & y=3: 10;
endrewards